PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/attendeasy
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# How the login cookie is allowed to travel. Leave this unset and it follows
# NODE_ENV: "lax" in development, "none" in production.
# "none" is what lets the cookie reach an API hosted on a different site, and it
# forces the cookie to require HTTPS. Set it to "lax" only when the frontend and
# the API are served from the same site.
# COOKIE_SAME_SITE=none

# Whether the cookie insists on HTTPS. Unset it and the API requires HTTPS in
# production, except that "none" always does. Set it to false to run a
# single-origin deployment over plain HTTP, such as a local Docker container
# reached by its LAN address.
# COOKIE_SECURE=false
